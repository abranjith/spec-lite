{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abranjith/spec-lite/main/schema/hooks.schema.json",
  "title": "spec-lite hooks.json",
  "type": "object",
  "required": [
    "version",
    "hooks"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "hooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hook"
      }
    }
  },
  "$defs": {
    "hook": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Concrete event names or wildcard patterns (e.g. \"implement.*\"). Known concrete events: brainstorm.pre, brainstorm.post, plan.pre, plan.post, plan-feature.pre, plan-feature.post, architect.pre, architect.post, plan-critic.pre, plan-critic.post, build-data-model.pre, build-data-model.post, feature.pre, feature.post, feature.spec.post, implement.pre, implement.post, implement.task.pre, implement.task.post, implement.feature.post, review.pre, review.post, review.verdict, fix.pre, fix.post, write-unit-tests.pre, write-unit-tests.post, write-integration-tests.pre, write-integration-tests.post, document.pre, document.post, document-design.post, document-feature.post, document-usage.post, document-readme.post, devops.pre, devops.post, memorize.post, todo.post, tool-help.post, yolo.pre, yolo.post, yolo.phase.post, hook.error."
        },
        "type": {
          "enum": [
            "command",
            "script",
            "http",
            "builtin",
            "skill",
            "agent",
            "prompt"
          ]
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "order": {
          "type": "number",
          "default": 100
        },
        "timeoutMs": {
          "type": "number",
          "default": 30000
        },
        "onFailure": {
          "enum": [
            "warn",
            "abort",
            "ignore"
          ],
          "default": "warn"
        },
        "once": {
          "type": "boolean",
          "default": false
        },
        "payloadSchema": {
          "type": "object"
        },
        "builtin": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "description": "Settings of a builtin that declares them; see the builtin options table in docs/features/hooks.md."
        },
        "run": {
          "type": "string"
        },
        "shell": {
          "enum": [
            "auto",
            "bash",
            "pwsh"
          ],
          "default": "auto"
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "default": "POST"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "bodyTemplate": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "args": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "events"
            ]
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "type"
              ]
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "name",
                "enabled",
                "options",
                "order",
                "timeoutMs",
                "onFailure"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "command"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "run"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "script"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "run"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "http"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "skill"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "skill"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "agent"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "agent"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "prompt"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "prompt"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "type"
                      ]
                    }
                  },
                  {
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "builtin"
                      }
                    }
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "builtin"
                    ],
                    "properties": {
                      "builtin": {
                        "const": "prepare-worktree"
                      }
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "builtin"
                      ]
                    },
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "prepare-worktree"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "fromBranch": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Branch new worktrees start from: local (`develop`) or remote-tracking (`origin/develop`). Default: the main checkout's current branch; `validate` warns when unset."
                  },
                  "fetch": {
                    "type": "boolean",
                    "description": "Fetch `fromBranch` from `remote` first and start from the remote's latest commit. Default: `false`."
                  },
                  "remote": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Remote `fetch` reads from. Default: `origin`."
                  },
                  "worktreeRoot": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Folder for worktrees, relative to the main checkout. Default: `.worktrees`."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "type"
                      ]
                    }
                  },
                  {
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "builtin"
                      }
                    }
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "builtin"
                    ],
                    "properties": {
                      "builtin": {
                        "const": "commit-progress"
                      }
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "builtin"
                      ]
                    },
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "commit-progress"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "remote": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Remote to push to. Recorded for `create-pull-request` and cleanup. Default: `origin`."
                  },
                  "commitMessage": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Commit subject template using `${id}` (feature ID, or the branch), `${task}`, `${summary}`, and `${branch}`; `${task:-final}` sets a default. Default: `FEAT-020 TASK-003: <summary>`."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "type"
                      ]
                    }
                  },
                  {
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "builtin"
                      }
                    }
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "builtin"
                    ],
                    "properties": {
                      "builtin": {
                        "const": "create-pull-request"
                      }
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "builtin"
                      ]
                    },
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "const": "create-pull-request"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "provider": {
                    "enum": [
                      "github",
                      "azure-devops",
                      "command"
                    ],
                    "description": "Where pull requests are opened; `command` runs your own adapter."
                  },
                  "targetBranch": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Branch pull requests merge into. Never inferred."
                  },
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "`command` provider: executable and arguments that create a PR."
                  },
                  "lookupCommand": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "`command` provider: executable and arguments that find existing PRs."
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
