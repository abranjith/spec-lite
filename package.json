{
  "name": "@abranjith/spec-lite",
  "version": "0.4.3",
  "description": "Lightweight, modular, LLM-agnostic agents and skills for structured software engineering — installable CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "spec-lite": "dist/index.js"
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "references",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json}\"",
    "precommit": "lint-staged",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "generate:hooks-schema": "tsx scripts/generate-hooks-schema.mjs",
    "generate:hook-docs": "tsx scripts/generate-hook-docs.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.json": "prettier --write"
  },
  "keywords": [
    "ai",
    "llm",
    "prompts",
    "copilot",
    "claude",
    "cursor",
    "agents",
    "sdlc",
    "cli",
    "spec"
  ],
  "author": "Ranjith A B",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abranjith/spec-lite"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.12.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
